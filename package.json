{
  "name": "khabri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db execute --file prisma/migrations/0_init/migration.sql --schema prisma/schema.prisma",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "eval": "tsx --env-file=.env scripts/eval.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:isolation": "tsx --env-file=.env tests/session-isolation.test.ts",
    "test:injection": "tsx --env-file=.env tests/injection-defense.test.ts",
    "test:fallback": "tsx --env-file=.env tests/model-fallback.test.ts",
    "test": "tsx tests/chunker.test.ts && tsx tests/retrieval.test.ts && tsx tests/citation-prompt.test.ts && tsx tests/ratelimit-cache.test.ts && tsx --env-file=.env tests/model-fallback.test.ts && tsx --env-file=.env tests/session-isolation.test.ts && tsx --env-file=.env tests/injection-defense.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^1.66.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
